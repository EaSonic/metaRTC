/usr/local/Cellar/qt@5/5.15.17/lib/QtOpenGL.framework/Resources/QtOpenGL.prl:
/usr/local/Cellar/qt@5/5.15.17/lib/QtWidgets.framework/Resources/QtWidgets.prl:
