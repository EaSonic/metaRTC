####### Install

install_target: first FORCE
	@test -d $(INSTALL_ROOT)/opt/metaplayer7/bin || mkdir -p $(INSTALL_ROOT)/opt/metaplayer7/bin
	$(DEL_FILE) -r $(INSTALL_ROOT)/opt/metaplayer7/bin/metaplayer7.app
	
	$(QINSTALL) ../../bin/app_release/metaplayer7.app $(INSTALL_ROOT)/opt/metaplayer7/bin/metaplayer7.app
	-$(STRIP) $(INSTALL_ROOT)/opt/metaplayer7/bin/metaplayer7.app/Contents/MacOS/$(QMAKE_TARGET)

uninstall_target: FORCE
	-$(DEL_FILE) -r $(INSTALL_ROOT)/opt/metaplayer7/bin/metaplayer7.app
	-$(DEL_DIR) $(INSTALL_ROOT)/opt/metaplayer7/bin/ 


install: install_target  FORCE

uninstall: uninstall_target  FORCE

FORCE:

